# ─── Base ──────────────────────────────────────────────
# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Base de données (SQLite en local ; voir README pour PostgreSQL en production)
DATABASE_URL="file:./dev.db"
# Secret de signature des sessions : générez-le avec `openssl rand -base64 32`
AUTH_SECRET=""
# Emails (séparés par des virgules) ayant accès à /admin
ADMIN_EMAILS=""

# ─── IA (Claude, Anthropic) ────────────────────────────
# Sans clé, le site utilise un générateur local (moins bon mais fonctionnel)
ANTHROPIC_API_KEY=""

# ─── Emails (Resend, gratuit jusqu'à 3 000/mois) ────────
# Mot de passe oublié, bienvenue, confirmation Premium, formulaire de contact
RESEND_API_KEY=""
# Expéditeur (domaine vérifié dans Resend), ex. "CV Express <bonjour@cv-express.fr>"
EMAIL_FROM=""
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=""

# ─── Paiements (Stripe) ────────────────────────────────
# Le plus simple : laissez vide et connectez Stripe depuis /admin/stripe.
# (Si vous les renseignez ici, elles sont prioritaires.)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ─── PayPal (en plus de Stripe) ─────────────────────────
# Le plus simple : laissez vide et connectez PayPal depuis /admin/paypal.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" (tests) ou "live" (vrais paiements)
PAYPAL_MODE="sandbox"
# Identifiant du webhook PayPal (créé automatiquement par /admin/paypal)
PAYPAL_WEBHOOK_ID=""

# Mode démo : "true" active Premium sans paiement quand Stripe n'est pas configuré.
# NE JAMAIS activer en production.
DEMO_MODE="false"
